# Build-time image selection.
# Pin this to an exact official OpenClaw release tag for deterministic deployments.
OPENCLAW_VERSION=latest

# Hall Of Fame skill source.
HOF_PLUGINS_REPO=halloffame-hq/halloffame.plugins
HOF_PLUGINS_REF=main

# Runtime gateway authentication.
OPENCLAW_GATEWAY_TOKEN=replace-with-a-long-random-secret

# Optional. Railway's generated public domain is used automatically when this is empty.
# Set this when using your own custom domain.
OPENCLAW_PUBLIC_ORIGIN=

# Model/provider credentials go here as required by your OpenClaw setup.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
